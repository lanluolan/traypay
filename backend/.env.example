# Copy to .env and fill in. .env is gitignored.

# --- Database ---
# 用只对 payment 库授权的专用账号，不要用 root。
DB_USER=checkout
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
# 宿主机若已有 MySQL 占着 3306，把开发容器映射到别的端口（如 3307）并改这里。
DB_PORT=3306
DB_NAME=payment
# Or set the full URI directly (takes precedence over DB_* above):
# DATABASE_URL=mysql+pymysql://user:pass@host:3306/payment

# --- App ---
# dev | pro   (代码里不设此变量时默认 pro)
# dev 会开启 DEBUG，也就是 Werkzeug 交互式调试器 —— 那是远程代码执行入口，
# 只能在本机用。这个模板保持 pro，以免照抄到生产环境。
APP_ENV=pro
# 仅 `python manage.py`（开发服务器）会读这两个；生产由 gunicorn --bind 决定。
FLASK_RUN_HOST=127.0.0.1
FLASK_RUN_PORT=5000

# --- Auth ---
# 签发登录 token 用。没有它生产环境会拒绝启动 —— 内置默认值等于公开密钥，
# 任何人都能伪造任意账号的 token。换掉它会让所有已签发的 token 立即失效。
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-generate-a-real-one
# token 有效期（秒），默认 7 天。token 是无状态的，改短它是唯一的"提前吊销"手段。
# AUTH_TOKEN_MAX_AGE=604800

# --- Dish recognition (see ../recognition/README.md) ---
DISH_STORE_DIR=dish_feature_store
# 不设也可以：默认已指向 recognition/weights/yolov8n.pt（见 config.py 的
# _default_detector_weights）。这里显式写出来只是为了让配置一目了然。
# 设为 "none" 则只能整图录入样本；托盘识别将明确报错，需人工录单。
DISH_DETECTOR_WEIGHTS=../recognition/weights/yolov8n.pt
# DISH_ACCEPT_THRESHOLD=0.60
# 前两名分差不足时要求人工选择；0.05 是待现场标定的初始值。
# DISH_AMBIGUITY_MARGIN=0.05
